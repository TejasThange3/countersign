# Copy to .env and fill in. Never commit .env.
# .worktreeinclude copies .env into every agent worktree automatically.

# --- ArmorIQ (platform.armoriq.ai -> Settings -> API Keys) ---
ARMORIQ_API_KEY=
ARMORIQ_AGENT_NAME=countersign
# The real server is registered as hotel-mcp-2: the Day 1 toy 'hotel-mcp' can't be deleted in the
# console, and plan steps are pinned to this name so tools never resolve to the toy server.
ARMORIQ_MCP_NAME=hotel-mcp-2
# Identities used with for_user(). Non-members fall under the policy's "clients" rule, so these
# only need to be real, mail-receiving addresses if you invite them as members (member rules).
ARMORIQ_USER_UNVERIFIED=
ARMORIQ_USER_GUEST=
ARMORIQ_USER_MANAGER=
# Approver for held calls: your platform.armoriq.ai login (an org member with a high enough
# approval limit). Local .env only, never CI: with the API key it can approve held calls.
ARMORIQ_ADMIN_EMAIL=
# Optional dashboard session token; unused so far. Never commit, never put in CI.
ARMORIQ_DASHBOARD_JWT=
# Baseline switch: 1 = run the identical agent with no enforcement (for with/without evals)
DISABLE_ARMORIQ=0

# --- Hotel MCP server ---
# Public HTTPS URL ending in /mcp (Railway, HF Space, or cloudflared tunnel)
MCP_URL=http://localhost:8000/mcp
# Bearer token the MCP server requires; register the same value as the MCP credential in ArmorIQ
MCP_BEARER_TOKEN=
PORT=8000

# --- Database ---
# Local dev (infra/docker-compose.yml); Neon pooled URL in deployment
DATABASE_URL=postgresql+asyncpg://countersign:countersign@localhost:5432/countersign

# --- Redis (local Docker) ---
REDIS_URL=redis://localhost:6379/0

# --- Models and voice ---
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# --- Observability (Langfuse Cloud, OTLP) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Dashboard ---
NEXT_PUBLIC_AGENT_URL=http://localhost:7860

# --- Gateway / evals wiring ---
# Import path of the GatewayFactory the agent and eval runner use (fake until the bridge merges)
GATEWAY_FACTORY=countersign_agent.bridge:factory
# Agent text-mode endpoint the eval conversation driver calls
AGENT_TEXT_URL=http://localhost:7860
# ArmorIQ backend for the approver's HTTP calls (production default)
ARMORIQ_BACKEND_ENDPOINT=https://api.armoriq.ai
# Approver pacing; ArmorIQ delegation endpoints allow roughly 30-60 requests per minute
APPROVER_CALLS_PER_MINUTE=30

# --- Bridge tuning (optional; defaults shown in comments) ---
# Failed verify_guest attempts per call before the bridge locks verification (default 3)
ARMORIQ_VERIFY_MAX_ATTEMPTS=
# Seconds between approval status polls while a call is held (default 5)
ARMORIQ_APPROVAL_POLL_SECONDS=
# Lifetime of one call's ArmorIQ session/plan, longer than the longest call (default 3600)
ARMORIQ_SESSION_VALIDITY_SECONDS=

# --- Groq (LLM; free tier at console.groq.com) ---
GROQ_API_KEY=
