# Copy to .env and fill in. Never commit .env.
# .worktreeinclude copies .env into every agent worktree automatically.

# --- ArmorIQ (platform.armoriq.ai -> Settings -> API Keys) ---
ARMORIQ_API_KEY=
ARMORIQ_AGENT_NAME=countersign
# The real server is registered as hotel-mcp-2: the Day 1 toy 'hotel-mcp' can't be deleted in the
# console, and plan steps are pinned to this name so tools never resolve to the toy server.
ARMORIQ_MCP_NAME=hotel-mcp-2
# Identities used with for_user(). Non-members fall under the policy's "clients" rule, so these
# only need to be real, mail-receiving addresses if you invite them as members (member rules).
ARMORIQ_USER_UNVERIFIED=
ARMORIQ_USER_GUEST=
ARMORIQ_USER_MANAGER=
# Approver for held calls: your platform.armoriq.ai login (an org member with a high enough
# approval limit). Local .env only, never CI: with the API key it can approve held calls.
ARMORIQ_ADMIN_EMAIL=
# Optional dashboard session token; unused so far. Never commit, never put in CI.
ARMORIQ_DASHBOARD_JWT=
# Baseline switch: 1 = run the identical agent with no enforcement (for with/without evals)
DISABLE_ARMORIQ=0

# --- Hotel MCP server ---
# Public HTTPS URL ending in /mcp (Railway, HF Space, or cloudflared tunnel)
MCP_URL=http://localhost:8000/mcp
# Bearer token the MCP server requires; register the same value as the MCP credential in ArmorIQ
MCP_BEARER_TOKEN=
PORT=8000

# --- Database ---
# Local dev (infra/docker-compose.yml); Neon pooled URL in deployment
DATABASE_URL=postgresql+asyncpg://countersign:countersign@localhost:5432/countersign

# --- Redis (local Docker) ---
REDIS_URL=redis://localhost:6379/0

# --- Models and voice ---
GEMINI_API_KEY=
ELEVENLABS_API_KEY=

# --- Observability (Langfuse Cloud, OTLP) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Dashboard ---
NEXT_PUBLIC_AGENT_URL=http://localhost:7860

# --- Gateway / evals wiring ---
# Import path of the GatewayFactory the agent and eval runner use (fake until the bridge merges)
GATEWAY_FACTORY=countersign_agent.bridge:factory
# Agent text-mode endpoint the eval conversation driver calls
AGENT_TEXT_URL=http://localhost:7860
# ArmorIQ backend for the approver's HTTP calls (production default)
ARMORIQ_BACKEND_ENDPOINT=https://api.armoriq.ai
# Approver pacing; ArmorIQ delegation endpoints allow roughly 30-60 requests per minute
APPROVER_CALLS_PER_MINUTE=30

# --- Bridge tuning (optional; defaults shown in comments) ---
# Failed verify_guest attempts per call before the bridge locks verification (default 3)
ARMORIQ_VERIFY_MAX_ATTEMPTS=
# Seconds between approval status polls while a call is held (default 5)
ARMORIQ_APPROVAL_POLL_SECONDS=
# Lifetime of one call's ArmorIQ session/plan, longer than the longest call (default 3600)
ARMORIQ_SESSION_VALIDITY_SECONDS=

# --- Groq (LLM; free tier at console.groq.com) ---
GROQ_API_KEY=

# --- Voice agent (apps/agent) ---
# LLM provider: groq (default) or gemini
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# Empty = pin LLM_MODEL with no fallback (use for eval runs so results never mix models)
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low
LLM_RATE_LIMIT_MAX_WAIT_S=
LLM_MODEL_COOLDOWN_S=
LLM_REQUEST_TIMEOUT_S=
# Gemini (opt-in; free tier is 20 requests/day per model)
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_RATE_LIMIT_RETRIES=
GEMINI_RATE_LIMIT_BACKOFF_S=
GEMINI_FIRST_CHUNK_TIMEOUT_S=
GEMINI_LAST_MODEL_TIMEOUT_S=
GEMINI_MODEL_COOLDOWN_S=
# Speech-to-text: whisper = local faster-whisper on the GPU (0 credits);
# groq = Whisper on Groq (uses GROQ_API_KEY; for hosts without a GPU, e.g. Railway)
STT_PROVIDER=whisper
GROQ_STT_MODEL=whisper-large-v3-turbo
# Optional format hint for Groq Whisper; off (empty): it was once echoed back as the transcript
GROQ_STT_PROMPT=
# groq only: fall back to ElevenLabs Scribe when Groq fails or rate-limits (credits only when used)
STT_FALLBACK_ELEVENLABS=true
GROQ_STT_TIMEOUT_S=6
GROQ_STT_COOLDOWN_S=60
WHISPER_MODEL=distil-large-v3
WHISPER_DEVICE=
# Opt-in only: measured to hurt accuracy on this setup
WHISPER_INITIAL_PROMPT=
WHISPER_HOTWORDS=
# Voice activity detection (measured on laptop speakers; confidence gate blocks bot echo)
VAD_CONFIDENCE=0.7
VAD_MIN_VOLUME=0.4
VAD_START_SECS=0.2
# Silence (s) that ends a speech segment; longer keeps a spelled reference in one piece
VAD_STOP_SECS=0.5
# Text-to-speech
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Holds
HOLD_TIMEOUT_S=
# While a manager decides: music (generated), silence, or voice (spoken line every interval)
HOLD_AUDIO=music
HOLD_MUSIC_START_S=4.5
HOLD_FILLER_INTERVAL_S=
HOLD_FILLER_CACHE_DIR=
# Agent server
# Website origins allowed to call the agent from a browser, comma-separated (e.g. the Vercel URL)
CORS_ORIGINS=
# Demo only: the caller decides their own held request as the manager (ArmorIQ approval API, as ARMORIQ_ADMIN_EMAIL)
DEMO_MANAGER_APPROVALS=false
# Demo only: said instead of silence when every LLM model is rate limited (empty: fail loudly, as evals need)
LLM_BUSY_MESSAGE=
AGENT_HOST=127.0.0.1
AGENT_PORT=7860
# Dev only: saves caller audio per call. Keep OUTSIDE the repo; never commit recordings.
DEBUG_RECORD_DIR=
