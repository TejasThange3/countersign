# Secrets: never commit. Copy .env.example to .env and fill it in.
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Next.js
node_modules/
.next/
out/

# Claude Code: per-agent worktrees and local-only settings/state
.claude/worktrees/
.claude/settings.local.json
.claude/state/

# Review files written by Codex (working files, not history)
reviews/

# Generated audio from eval runs (reports JSON/MD are committed, audio is not)
evals/reports/**/*.wav
evals/reports/**/*.mp3

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
